{
    admin off
    auto_https off
}

:3001 {
    @session_socket {
        path_regexp session_live ^/sessions/[0-9a-fA-F-]+/live$
        header Upgrade websocket
    }
    handle @session_socket {
        reverse_proxy session:3001
    }
    handle {
        respond "WebSocket endpoint only" 404
    }
}

:3002 {
    @dm_socket {
        path /ws
        header Upgrade websocket
    }
    handle @dm_socket {
        reverse_proxy dm-service:3000
    }
    handle {
        respond "WebSocket endpoint only" 404
    }
}
