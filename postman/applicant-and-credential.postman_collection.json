        {
          "name": "Credential: Validate documents (internal, Moderation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 CredentialValidation', () => { pm.response.to.have.status(200); const v = pm.response.json();",
                  "  pm.expect(v.documentsValid).to.be.a('boolean');",
                  "  pm.expect(v.results.length).to.eql(Number(pm.collectionVariables.get('docCount')));",
                  "  v.results.forEach(r => { pm.expect(r).to.have.all.keys('credentialId','type','structurallyValid','authentic','issues');",
                  "    r.issues.forEach(i => pm.expect(['missing_field','malformed_field','expired','signature_mismatch','field_conflict']).to.include(i.code)); });",
                  "  pm.expect(v.documentsValid).to.eql(v.results.every(r => r.issues.length === 0)); });"
                ]
              }
            }
          ],
