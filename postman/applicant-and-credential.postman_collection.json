        {
          "name": "Applicant: Get applicant (internal, with impostor flag)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 Applicant', () => { pm.response.to.have.status(200); const a = pm.response.json();",
                  "  pm.expect(a).to.include.all.keys('applicantId','name','studentId','major','year','role','universityStatus','courses','isImpostor','strategy');",
                  "  pm.expect(a.isImpostor).to.be.a('boolean');",
                  "  pm.expect(['none','forged_document','expired_document','identity_theft','wrong_major','banned_retry']).to.include(a.strategy); });"
                ]
              }
