{
  "info": {
    "name": "Applicant and Credential Services",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against the team stack (docker compose up). Set serviceSecret to SERVICE_SECRET from .env. The setup folder opens a real session through Player and Session, so the session tokens are the real ones."
  },
  "item": [
    {
      "name": "0. Setup: players and a session",
      "item": [
        {
          "name": "Register moderator",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('moderatorName', 'mod' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('moderatorId', pm.response.json().playerId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{playerBaseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{moderatorName}}\",\n  \"email\": \"{{moderatorName}}@utm.md\",\n  \"password\": \"correcthorse1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Register junior mod",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('juniorName', 'jr' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('juniorId', pm.response.json().playerId);",
                  "pm.collectionVariables.set('juniorPlayerToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{playerBaseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{juniorName}}\",\n  \"email\": \"{{juniorName}}@utm.md\",\n  \"password\": \"correcthorse1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Open a session (as Player would)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('sessionId', pm.response.json().sessionId);",
                  "pm.collectionVariables.set('moderatorToken', pm.response.json().sessionToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Service-Secret",
                "value": "{{serviceSecret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{sessionBaseUrl}}/sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": \"{{$guid}}\",\n  \"moderatorId\": \"{{moderatorId}}\",\n  \"members\": [\n    {\n      \"playerId\": \"{{moderatorId}}\",\n      \"level\": 1\n    },\n    {\n      \"playerId\": \"{{juniorId}}\",\n      \"level\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Junior mod joins the session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 junior_mod', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().role).to.eql('junior_mod'); });",
                  "pm.collectionVariables.set('juniorToken', pm.response.json().sessionToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{juniorPlayerToken}}"
              }
            ],
            "url": "{{sessionBaseUrl}}/sessions/{{sessionId}}/join"
          }
        },
        {
          "name": "Open another session (for mismatch checks)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('otherSessionId', pm.response.json().sessionId);",
                  "pm.collectionVariables.set('otherSessionToken', pm.response.json().sessionToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Service-Secret",
                "value": "{{serviceSecret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{sessionBaseUrl}}/sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": \"{{$guid}}\",\n  \"moderatorId\": \"{{moderatorId}}\",\n  \"members\": [\n    {\n      \"playerId\": \"{{moderatorId}}\",\n      \"level\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
