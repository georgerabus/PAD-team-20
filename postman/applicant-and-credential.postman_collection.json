                  "// Staff and outsiders may carry no documents: make another applicant until one has some.",
                  "const docs = pm.response.json(); const tries = Number(pm.collectionVariables.get('credTries') || 0);",
                  "if (docs.length === 0 && tries < 10) { pm.collectionVariables.set('credTries', tries + 1); pm.execution.setNextRequest('Credential: Create applicant'); }",
                  "else { pm.collectionVariables.set('credTries', 0); pm.collectionVariables.set('credentialId', docs[0].credentialId); pm.collectionVariables.set('docCount', docs.length); }"
                ]
