              "raw": "{\n  \"teamId\": \"{{$guid}}\",\n  \"moderatorId\": \"{{moderatorId}}\",\n  \"members\": [\n    {\n      \"playerId\": \"{{moderatorId}}\",\n      \"level\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
