              {
                "key": "Authorization",
                "value": "Bearer {{moderatorToken}}"
              }
            ],
            "url": "{{gatewayBaseUrl}}/credential/credentials/33333333-3333-4333-8333-333333333333"
          }
        },
        {
          "name": "Credential: Validate documents (internal, Moderation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 CredentialValidation', () => { pm.response.to.have.status(200); const v = pm.response.json();",
                  "  pm.expect(v.documentsValid).to.be.a('boolean');",
                  "  pm.expect(v.results.length).to.eql(Number(pm.collectionVariables.get('docCount')));",
                  "  v.results.forEach(r => { pm.expect(r).to.have.all.keys('credentialId','type','structurallyValid','authentic','issues');",
                  "    r.issues.forEach(i => pm.expect(['missing_field','malformed_field','expired','signature_mismatch','field_conflict']).to.include(i.code)); });",
                  "  pm.expect(v.documentsValid).to.eql(v.results.every(r => r.issues.length === 0)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{internalBaseUrl}}/credential/applicants/{{credApplicantId}}/credentials/validate"
          }
        },
        {
          "name": "Credential: Validate on the public port",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 INTERNAL_ENDPOINT', () => { pm.response.to.have.status(403); const b = pm.response.json(); pm.expect(b).to.have.all.keys('error','message','details'); pm.expect(b.error).to.eql('INTERNAL_ENDPOINT'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorToken}}"
              }
            ],
            "url": "{{gatewayBaseUrl}}/credential/applicants/{{credApplicantId}}/credentials/validate"
          }
        },
        {
          "name": "Credential: Validate a missing applicant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 APPLICANT_NOT_FOUND', () => { pm.response.to.have.status(404); const b = pm.response.json(); pm.expect(b).to.have.all.keys('error','message','details'); pm.expect(b.error).to.eql('APPLICANT_NOT_FOUND'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{internalBaseUrl}}/credential/applicants/33333333-3333-4333-8333-333333333333/credentials/validate"
          }
        }
      ]
    },
    {
      "name": "3. The Gateway boundary",
      "item": [
        {
          "name": "Boundary: Identity headers without a token are refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Without a token this is all a forger has, and it buys nothing.",
                  "pm.test('401 INVALID_TOKEN', () => { pm.response.to.have.status(401); const b = pm.response.json(); pm.expect(b).to.have.all.keys('error','message','details'); pm.expect(b.error).to.eql('INVALID_TOKEN'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Player-Id",
                "value": "{{moderatorId}}"
              },
              {
                "key": "X-Session-Id",
                "value": "{{sessionId}}"
              },
              {
                "key": "X-Session-Role",
                "value": "moderator"
              }
            ],
            "url": "{{gatewayBaseUrl}}/applicant/applicants/{{applicantId}}/public"
          }
        },
        {
          "name": "Boundary: The token decides the session, not the header",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The Gateway replaces X-Session-Id with the session in the token.",
                  "pm.test('403 SESSION_MISMATCH', () => { pm.response.to.have.status(403); const b = pm.response.json(); pm.expect(b).to.have.all.keys('error','message','details'); pm.expect(b.error).to.eql('SESSION_MISMATCH'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherSessionToken}}"
              },
              {
                "key": "X-Session-Id",
                "value": "{{sessionId}}"
              }
            ],
            "url": "{{gatewayBaseUrl}}/applicant/applicants/{{applicantId}}/public"
          }
        },
        {
          "name": "Boundary: The token decides the role, not the header",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A junior mod cannot promote itself to read a document.",
                  "pm.test('403 ROLE_NOT_ALLOWED', () => { pm.response.to.have.status(403); const b = pm.response.json(); pm.expect(b).to.have.all.keys('error','message','details'); pm.expect(b.error).to.eql('ROLE_NOT_ALLOWED'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{juniorToken}}"
              },
              {
                "key": "X-Session-Role",
                "value": "moderator"
              }
            ],
            "url": "{{gatewayBaseUrl}}/credential/credentials/{{credentialId}}"
          }
        },
        {
          "name": "Boundary: An internal endpoint written differently is still refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// /applicants/{id}/public/.. is /applicants/{id}, the full applicant with the",
                  "// impostor flag. The Gateway normalises the path before deciding.",
                  "pm.test('403 INTERNAL_ENDPOINT', () => { pm.response.to.have.status(403); const b = pm.response.json(); pm.expect(b).to.have.all.keys('error','message','details'); pm.expect(b.error).to.eql('INTERNAL_ENDPOINT'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorToken}}"
              }
            ],
            "url": "{{gatewayBaseUrl}}/applicant/applicants/{{applicantId}}/public/.."
          }
        }
      ]
    },
    {
      "name": "4. Through the broker",
      "description": "Session does not call `POST /applicants` through the Gateway any more. It names the operation `CreateApplicant` and the Message Broker picks an instance of `applicant` from the registry, so the caller never holds an address and carries no circuit breaker of its own.\n\nThe broker publishes no port, so these run from inside the Docker network, like the internal requests above.",
      "item": [
        {
          "name": "Session asks for an applicant, through the broker",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messageId\": \"{{messageId}}\",\n  \"correlationId\": \"{{messageId}}\",\n  \"kind\": \"request\",\n  \"source\": \"session\",\n  \"target\": \"applicant\",\n  \"topic\": null,\n  \"operation\": \"CreateApplicant\",\n  \"identity\": null,\n  \"payload\": { \"sessionId\": \"{{sessionId}}\" }\n}"
            },
            "url": {
              "raw": "{{brokerBaseUrl}}/messages",
              "host": [
                "{{brokerBaseUrl}}"
              ],
              "path": [
                "messages"
              ]
            },
            "description": "The envelope Session sends. `target` names the service, not an instance."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The idempotency key. A receiver that honours it must not",
                  "// apply the same messageId twice, which is what makes the",
                  "// broker's retries safe.",
                  "pm.collectionVariables.set('messageId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the broker carried it', () => pm.response.to.have.status(200));",
                  "const reply = pm.response.json();",
                  "// 200 says the broker delivered the message. How the call",
                  "// itself went is the reply's own status.",
                  "pm.test('Applicant answered 201', () => pm.expect(reply.status).to.eql(201));",
                  "pm.test('the answer came from applicant', () => {",
                  "  pm.expect(reply.source).to.eql('applicant');",
                  "  pm.expect(reply.instance).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('correlated with the request', () => {",
                  "  pm.expect(reply.inReplyTo).to.eql(pm.collectionVariables.get('messageId'));",
                  "});",
                  "pm.collectionVariables.set('brokerApplicantId', reply.payload.applicantId);"
                ]
              }
            }
          ]
        },
        {
          "name": "The applicant it created is a real one",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{juniorToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/applicant/applicants/{{brokerApplicantId}}/public",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "applicant",
                "applicants",
                "{{brokerApplicantId}}",
                "public"
              ]
            },
            "description": "Read through the Gateway, as a junior mod would. An applicant made through the broker is no different from one made through REST \u2014 the same handler wrote it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('it is the applicant the broker asked for', () => {",
                  "  pm.expect(pm.response.json().applicantId).to.eql(",
                  "    pm.collectionVariables.get('brokerApplicantId'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "gatewayBaseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "internalBaseUrl",
      "value": "http://gateway:8001"
    },
    {
      "key": "brokerBaseUrl",
      "value": "http://broker:8000"
    },
    {
      "key": "messageId",
      "value": ""
    }
  ]
}
