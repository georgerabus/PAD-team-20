                  "const token = pm.response.json().sessionToken;",
                  "pm.collectionVariables.set('juniorSessionToken', token);",
                  "// What a client does after shift_started: pick up its recordAccess.",
                  "const claims = JSON.parse(Buffer.from(token.split('.')[1], 'base64').toString());",
                  "pm.test('now carries recordAccess', () => pm.expect(claims.recordAccess).to.include('enrollment'));"
                ]
