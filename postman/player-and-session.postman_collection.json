                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('one correct decision, both players in the result', () => {",
                  "  pm.expect(body.correctDecisions).to.eql(1);",
                  "  pm.expect(body.perPlayer).to.have.lengthOf(2);",
                  "});",
                  "// Kept so the SessionCompleted event can be rebuilt below.",
                  "pm.collectionVariables.set('perPlayer', JSON.stringify(body.perPlayer));"
                ]
              }
