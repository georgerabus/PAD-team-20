          ]
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Deliver SessionCompleted to Player",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{internalBaseUrl}}/player/internal/events/session-completed",
              "host": [
                "{{internalBaseUrl}}"
              ],
              "path": [
                "player",
                "internal",
                "events",
                "session-completed"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"type\": \"SessionCompleted\",\n  \"occurredAt\": \"{{$isoTimestamp}}\",\n  \"sessionId\": \"{{sessionId}}\",\n  \"payload\": { \"sessionId\": \"{{sessionId}}\", \"perPlayer\": {{perPlayer}} }\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Kept in a variable so the redelivery below can reuse the same id.",
                  "pm.collectionVariables.set('eventId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Progression after the shift",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/player/players/{{moderatorId}}/progression",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "player",
                "players",
                "{{moderatorId}}",
                "progression"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('the shift was counted and xp awarded', () => {",
                  "  pm.expect(body.completedShifts).to.eql(1);",
                  "  pm.expect(body.xp).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Redelivery changes nothing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{internalBaseUrl}}/player/internal/events/session-completed",
              "host": [
                "{{internalBaseUrl}}"
              ],
              "path": [
                "player",
                "internal",
                "events",
                "session-completed"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"type\": \"SessionCompleted\",\n  \"occurredAt\": \"{{$isoTimestamp}}\",\n  \"sessionId\": \"{{sessionId}}\",\n  \"payload\": { \"sessionId\": \"{{sessionId}}\", \"perPlayer\": {{perPlayer}} }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Progression is unchanged",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/player/players/{{moderatorId}}/progression",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "player",
                "players",
                "{{moderatorId}}",
                "progression"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('still one shift, not two', () => pm.expect(pm.response.json().completedShifts).to.eql(1));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "The Gateway boundary",
      "item": [
        {
          "name": "No token is refused",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayBaseUrl}}/player/players/{{moderatorId}}",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "player",
                "players",
                "{{moderatorId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('INVALID_TOKEN', () => pm.expect(pm.response.json().error).to.eql('INVALID_TOKEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "A header the caller sets is not believed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Player-Id",
                "value": "{{moderatorId}}"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/player/players/{{moderatorId}}",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "player",
                "players",
                "{{moderatorId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Without a token this is all a forger has, and it buys nothing:",
                  "// the Gateway strips X-Player-Id from whatever the client sent.",
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "The token decides who is calling, not the header",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorToken}}"
              },
              {
                "key": "X-Player-Id",
                "value": "{{juniorId}}"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/player/players/{{moderatorId}}",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "player",
                "players",
                "{{moderatorId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('the moderator, not the player named in the header', () => {",
                  "  pm.expect(pm.response.json().playerId).to.eql(pm.collectionVariables.get('moderatorId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "An internal endpoint is refused on the public port",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorSessionToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/session/sessions/{{sessionId}}/access-check?playerId={{juniorId}}&channel=enrollment-check",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "session",
                "sessions",
                "{{sessionId}}",
                "access-check"
              ],
              "query": [
                {
                  "key": "playerId",
                  "value": "{{juniorId}}"
                },
                {
                  "key": "channel",
                  "value": "enrollment-check"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));",
                  "pm.test('INTERNAL_ENDPOINT', () => pm.expect(pm.response.json().error).to.eql('INTERNAL_ENDPOINT'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Written differently, still refused",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorSessionToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/session/sessions/{{sessionId}}/../{{sessionId}}/access-check?playerId={{juniorId}}&channel=enrollment-check",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "session",
                "sessions",
                "{{sessionId}}",
                "..",
                "{{sessionId}}",
                "access-check"
              ],
              "query": [
                {
                  "key": "playerId",
                  "value": "{{juniorId}}"
                },
                {
                  "key": "channel",
                  "value": "enrollment-check"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The Gateway normalises the path before deciding, so a dot segment",
                  "// cannot smuggle an internal endpoint past it.",
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
