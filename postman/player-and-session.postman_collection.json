    {
      "name": "Server Moderation Session Service",
      "item": [
        {
          "name": "Open a session directly (internal, from Player)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Service-Secret",
                "value": "{{serviceSecret}}"
              }
            ],
            "url": {
              "raw": "{{sessionBaseUrl}}/sessions",
              "host": [
                "{{sessionBaseUrl}}"
              ],
              "path": [
                "sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": \"{{$guid}}\",\n  \"moderatorId\": \"{{moderatorId}}\",\n  \"members\": [\n    {\n      \"playerId\": \"{{moderatorId}}\",\n      \"level\": 3\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "// The endpoint Player itself calls, exercised on its own.",
