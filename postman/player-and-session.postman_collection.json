          "name": "Register moderator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/player/auth/register",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "player",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{moderatorName}}\",\n  \"email\": \"{{moderatorName}}@utm.md\",\n  \"password\": \"correcthorse1\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh username each run, so re-running never hits 409.",
                  "pm.collectionVariables.set('moderatorName', 'moderator' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('moderatorId', body.playerId);",
                  "pm.collectionVariables.set('moderatorToken', body.token);"
                ]
              }
            }
          ]
        },
