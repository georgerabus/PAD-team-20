          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Service-Secret",
                "value": "{{serviceSecret}}"
              }
            ],
            "url": {
              "raw": "{{sessionBaseUrl}}/sessions/{{sessionId}}/outcomes",
              "host": [
                "{{sessionBaseUrl}}"
              ],
              "path": [
                "sessions",
                "{{sessionId}}",
                "outcomes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decisionId\": \"{{$guid}}\",\n  \"applicantId\": \"{{applicantId}}\",\n  \"correct\": true,\n  \"penalty\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Session state",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorSessionToken}}"
              }
            ],
            "url": {
              "raw": "{{sessionBaseUrl}}/sessions/{{sessionId}}",
              "host": [
                "{{sessionBaseUrl}}"
              ],
              "path": [
                "sessions",
                "{{sessionId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('one application processed, score moved', () => {",
                  "  pm.expect(body.applicationsProcessed).to.eql(1);",
                  "  pm.expect(body.score).to.eql(10);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Channel access-check (internal, from Discord DMs)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Secret",
                "value": "{{serviceSecret}}"
              }
            ],
            "url": {
              "raw": "{{sessionBaseUrl}}/sessions/{{sessionId}}/access-check?playerId={{juniorId}}&channel=enrollment-check",
              "host": [
                "{{sessionBaseUrl}}"
              ],
              "path": [
                "sessions",
                "{{sessionId}}",
                "access-check"
              ],
              "query": [
                {
                  "key": "playerId",
                  "value": "{{juniorId}}"
                },
                {
                  "key": "channel",
                  "value": "enrollment-check"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('assigned channel is allowed', () => pm.expect(pm.response.json().allowed).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "End shift",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorSessionToken}}"
              }
            ],
            "url": {
              "raw": "{{sessionBaseUrl}}/sessions/{{sessionId}}/end",
              "host": [
                "{{sessionBaseUrl}}"
              ],
              "path": [
                "sessions",
                "{{sessionId}}",
                "end"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('one correct decision, both players in the result', () => {",
                  "  pm.expect(body.correctDecisions).to.eql(1);",
                  "  pm.expect(body.perPlayer).to.have.lengthOf(2);",
                  "});",
                  "// Kept so the SessionCompleted event can be rebuilt below.",
                  "pm.collectionVariables.set('perPlayer', JSON.stringify(body.perPlayer));"
                ]
              }
            }
          ]
        },
        {
          "name": "Session results",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{juniorSessionToken}}"
              }
            ],
            "url": {
              "raw": "{{sessionBaseUrl}}/sessions/{{sessionId}}/results",
              "host": [
                "{{sessionBaseUrl}}"
              ],
              "path": [
                "sessions",
                "{{sessionId}}",
                "results"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('same result as end returned', () => pm.expect(pm.response.json().sessionId).to.eql(pm.collectionVariables.get('sessionId')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Deliver SessionCompleted to Player",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Service-Secret",
                "value": "{{serviceSecret}}"
              }
            ],
            "url": {
              "raw": "{{playerBaseUrl}}/internal/events/session-completed",
              "host": [
                "{{playerBaseUrl}}"
              ],
              "path": [
                "internal",
                "events",
                "session-completed"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"type\": \"SessionCompleted\",\n  \"occurredAt\": \"{{$isoTimestamp}}\",\n  \"sessionId\": \"{{sessionId}}\",\n  \"payload\": { \"sessionId\": \"{{sessionId}}\", \"perPlayer\": {{perPlayer}} }\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Kept in a variable so the redelivery below can reuse the same id.",
                  "pm.collectionVariables.set('eventId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Progression after the shift",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorToken}}"
              }
            ],
            "url": {
              "raw": "{{playerBaseUrl}}/players/{{moderatorId}}/progression",
              "host": [
                "{{playerBaseUrl}}"
              ],
              "path": [
                "players",
                "{{moderatorId}}",
                "progression"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('the shift was counted and xp awarded', () => {",
                  "  pm.expect(body.completedShifts).to.eql(1);",
                  "  pm.expect(body.xp).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Redelivery changes nothing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Service-Secret",
                "value": "{{serviceSecret}}"
              }
            ],
            "url": {
              "raw": "{{playerBaseUrl}}/internal/events/session-completed",
              "host": [
                "{{playerBaseUrl}}"
              ],
              "path": [
                "internal",
                "events",
                "session-completed"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"type\": \"SessionCompleted\",\n  \"occurredAt\": \"{{$isoTimestamp}}\",\n  \"sessionId\": \"{{sessionId}}\",\n  \"payload\": { \"sessionId\": \"{{sessionId}}\", \"perPlayer\": {{perPlayer}} }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Progression is unchanged",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorToken}}"
              }
            ],
            "url": {
              "raw": "{{playerBaseUrl}}/players/{{moderatorId}}/progression",
              "host": [
                "{{playerBaseUrl}}"
              ],
              "path": [
                "players",
                "{{moderatorId}}",
                "progression"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('still one shift, not two', () => pm.expect(pm.response.json().completedShifts).to.eql(1));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Remove the team member",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorToken}}"
              }
            ],
            "url": {
              "raw": "{{playerBaseUrl}}/teams/{{teamId}}/members/{{juniorId}}",
              "host": [
                "{{playerBaseUrl}}"
              ],
              "path": [
                "teams",
                "{{teamId}}",
                "members",
                "{{juniorId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove the friend",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorToken}}"
              }
            ],
            "url": {
              "raw": "{{playerBaseUrl}}/players/{{moderatorId}}/friends/{{juniorId}}",
              "host": [
                "{{playerBaseUrl}}"
              ],
              "path": [
                "players",
                "{{moderatorId}}",
                "friends",
                "{{juniorId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
