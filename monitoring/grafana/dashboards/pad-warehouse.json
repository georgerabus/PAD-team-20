    {
      "id": 4,
      "type": "stat",
      "title": "Decision accuracy",
      "description": "Share of decisions that matched the rules' verdict.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pad-warehouse"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pad-warehouse"
          },
          "rawSql": "SELECT round(100.0 * avg(correct::int), 1) FROM fact_decision",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
