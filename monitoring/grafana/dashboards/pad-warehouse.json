    {
      "id": 5,
      "type": "stat",
      "title": "Impostors let in",
      "description": "Impostors a moderator accepted.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pad-warehouse"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pad-warehouse"
          },
          "rawSql": "SELECT count(*) FROM fact_decision d JOIN fact_applicant a USING (applicant_id) WHERE a.is_impostor AND d.action = 'accept'",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
