# Secrets for docker-compose.yml. Copy this file to .env, which is gitignored,
# and fill in every value. Generate each one with:
#   openssl rand -hex 32
# docker compose refuses to start while any of them is empty.

# Shared by Session and every service that calls its internal endpoints.
SERVICE_SECRET=

# One password per database: no service shares a database with another.
PLAYER_DB_PASSWORD=
SESSION_DB_PASSWORD=
DM_DB_PASSWORD=
MODERATION_DB_PASSWORD=

# server-rules: local lab authentication only
SERVER_RULES_APP_KEY=
SERVER_RULES_DB_PASSWORD=
SERVER_RULES_PORT=8001

# university-record: local lab authentication only
UNIVERSITY_RECORD_APP_KEY=
UNIVERSITY_RECORD_DB_PASSWORD=
UNIVERSITY_RECORD_PORT=8002
