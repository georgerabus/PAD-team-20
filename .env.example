# Configuration for docker-compose.yml. Copy to .env, which is gitignored.
# Generate each database/issuer secret with:
#   openssl rand -hex 32
# Required values must be filled before starting Compose.

# Published image references: use exact versions, never latest.
# Gateway release verified against the successful CI manifest digest.
GATEWAY_IMAGE=augustinploteanu/pad-gateway-service:3.0.0
# Lab 4 candidates:
SERVICE_DISCOVERY_IMAGE=georgerabus/pad-service-discovery:4.0.0-rc.2
BROKER_IMAGE=augustinploteanu/pad-message-broker:4.0.0-rc.5
APPLICANT_IMAGE=georgerabus/pad-applicant-service:4.0.0-rc.2
CREDENTIAL_IMAGE=georgerabus/pad-credential-service:4.0.0-rc.2
PLAYER_IMAGE=catalinasiminiuc/pad-player-service:4.0.0-rc.1
SESSION_IMAGE=catalinasiminiuc/pad-server-moderation-session-service:4.0.0-rc.1
DM_IMAGE=augustinploteanu/pad-dm-service:4.0.0
MODERATION_IMAGE=augustinploteanu/pad-moderation-service:4.0.0
# Final 3.0.0 tags of the presented 3.0.0-rc.1 images (same digests).
SERVER_RULES_IMAGE=loredanaaaa/server-rules-service:3.0.0
UNIVERSITY_RECORD_IMAGE=loredanaaaa/university-record-service:3.0.0

# Published endpoints: one REST entry, plus the WS-only Session and DM
# listeners. Each serves its socket on a port of its own and answers ordinary
# HTTP there with 426.
GATEWAY_HTTP_PORT=8080
# Session publishes one port per replica, from SESSION_WS_PORT to
# SESSION_WS_PORT_LAST: the range must hold at least SESSION_REPLICAS ports.
SESSION_WS_PORT=3011
SESSION_WS_PORT_LAST=3013
# DM publishes one port per replica, from DM_WS_PORT to DM_WS_PORT_LAST: the
# range must hold at least DM_REPLICAS ports.
DM_WS_PORT=3002
DM_WS_PORT_LAST=3004
# Addresses returned by the Gateway's /ws/negotiate endpoint to this laptop.
SESSION_PUBLIC_WS_BASE_URL=ws://127.0.0.1:${SESSION_WS_PORT}
DM_PUBLIC_WS_BASE_URL=ws://127.0.0.1:${DM_WS_PORT}
PAD_KEYS_DIR=./keys
GATEWAY_REQUEST_TIMEOUT_SECONDS=10
GATEWAY_MAX_CONCURRENT_REQUESTS=100
GATEWAY_MAX_CONCURRENT_INTERNAL_REQUESTS=100

# Service Discovery alerts when an instance reaches this share of its own
# limit. Leave ALERT_WEBHOOK_URL empty to only log the alerts; set it to a
# Discord webhook URL to have them sent there as well.
LOAD_CRITICAL_RATIO=0.8
ALERT_WEBHOOK_URL=

# The operator token for GET /logs/all on Service Discovery, which collects
# every instance's logs. Those lines carry what no player may see, such as
# which applicant is an impostor, so the endpoint takes a token of its own
# rather than a player's. Left empty it refuses every request.
LOGS_TOKEN=

# Grafana, started only with `docker compose --profile monitoring up -d`.
# Not 3000: the NestJS services use it inside the network, and it is the port
# most likely to be taken on a developer's machine.
GRAFANA_PORT=3300

# Replicas of the services that register with Service Discovery. Change them
# here, or at runtime with `docker compose up -d --scale <service>=<n>`.
PLAYER_REPLICAS=2
SESSION_REPLICAS=2
DM_REPLICAS=2
MODERATION_REPLICAS=2
APPLICANT_REPLICAS=2
CREDENTIAL_REPLICAS=2

# One password per database: no service shares a database with another.
PLAYER_DB_PASSWORD=
SESSION_DB_PASSWORD=
DM_DB_PASSWORD=
MODERATION_DB_PASSWORD=

SERVER_RULES_APP_KEY=
SERVER_RULES_DB_PASSWORD=

UNIVERSITY_RECORD_APP_KEY=
UNIVERSITY_RECORD_DB_PASSWORD=

# Applicant and Credential
APPLICANT_DB_PASSWORD=
CREDENTIAL_DB_PASSWORD=
CREDENTIAL_ISSUER_SECRET=
