# Secrets for docker-compose.yml. Copy this file to .env, which is gitignored,
# and fill in every value. Generate each one with:
#   openssl rand -hex 32
# docker compose refuses to start while any of them is empty.

# Shared by Session and every service that calls its internal endpoints.
SERVICE_SECRET=

# One password per database: no service shares a database with another.
PLAYER_DB_PASSWORD=
SESSION_DB_PASSWORD=
